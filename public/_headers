/*
  X-Content-Type-Options: nosniff

/*.mp4
  Content-Type: video/mp4
  Accept-Ranges: bytes
  Cache-Control: public, max-age=31536000, immutable

/*.jpg
  Content-Type: image/jpeg
  Cache-Control: public, max-age=86400

/*.jpeg
  Content-Type: image/jpeg
  Cache-Control: public, max-age=86400

/*.png
  Content-Type: image/png
  Cache-Control: public, max-age=86400

/assets/*
  Cache-Control: public, max-age=31536000, immutable
